# Copy to .env.local for `npm run dev`. Never commit real values.

# PostgreSQL (docker compose up -d starts one with these credentials)
DATABASE_URL=postgres://jastip:jastip@localhost:5432/jastip

# The owner account, created on first start. The password needs 12+ characters; change it later in the app.
OWNER_USERNAME=laili
OWNER_PASSWORD=change-me-to-something-long
OWNER_NAME=Laili

# Public demo: sample shop with fake payment accounts, a demo sign-in button, reset on every start.
DEMO_MODE=false

# Behind a hosting proxy (Render): use its X-Forwarded-For for sign-in throttling.
TRUST_PROXY=false
